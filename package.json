{
  "name": "tactris",
  "version": "1.0.0",
  "description": "Tactris Game",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "vite",
    "build": "vite build",
    "migrate": "node scripts/run-migrations.js",
    "rollback": "node scripts/rollback-migration.js",
    "cf:dev": "npm run build && wrangler dev",
    "cf:test": "vitest run",
    "cf:migrate:local": "wrangler d1 migrations apply tactris --local",
    "cf:migrate:remote": "wrangler d1 migrations apply tactris --remote",
    "cf:deploy": "npm run build && wrangler deploy",
    "cf:deploy:dry-run": "npm run build && wrangler deploy --dry-run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "vite": "^5.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@cloudflare/workers-types": "^5.20260821.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.32.0"
  }
}
